"/></mxCell><mxCell id="n_h4" value="Ventana: desde el inicio del parcial hasta la sustentación · Detención: ante hallazgo real o duda, parar y avisar al docente" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="1020" height="70" as="geometry"/></mxCell><mxCell id="n_o0" value="Sistemas de la UTS y de compañeros" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="135" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o1" value="Internet y sistemas de terceros" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="217" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o2" value="Cuentas reales de clientes&#xa;(Meta, Google Ads, TikTok)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="299" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o3" value="Redes domésticas de empleados" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="381" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o4" value="Datos personales reales" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="463" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o5" value="Malware real · ataques ofensivos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="545" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_o6" value="Escanear la propia instancia en la nube&#xa;si el proveedor no lo permite" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1170" y="627" width="480" height="66" as="geometry"/></mxCell><mxCell id="n_l1" value="Ley 1273 de 2009&#xa;acceso abusivo (269A), interceptación (269C),&#xa;daño informático (269D): por eso la carta&#xa;y el laboratorio aislado" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="520" height="140" as="geometry"/></mxCell><mxCell id="n_l2" value="Ley 1581 de 2012&#xa;los logs tienen datos personales:&#xa;finalidad de seguridad, acceso restringido,&#xa;retención 90 días + 12 meses" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="590" y="790" width="520" height="140" as="geometry"/></mxCell><mxCell id="n_l3" value="ISO/IEC 27001:2022 y NIST CSF 2.0&#xa;A.5.9 inventario · A.8.15–8.16 registro y&#xa;monitoreo · A.5.24–5.28 incidentes ·&#xa;ID.AM, DE.CM, RS.MA" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1130" y="790" width="520" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
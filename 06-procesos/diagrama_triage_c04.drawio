<mxfile host="app.diagrams.net"><diagram name="Flujo de triage del SOC N1 — Lumbre Digital"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1700" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flujo de triage del SOC N1 — Lumbre Digital" style="text;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="z_perm" value="Permitido al N1 (si el playbook lo indica)" style="rounded=1;dashed=1;fillColor=#EAF6EC;strokeColor=#2F7D3A;fontColor=#2F7D3A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;opacity=80;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="800" height="290" as="geometry"/></mxCell><mxCell id="z_proh" value="Prohibido al N1 (N2 o cambio aprobado)" style="rounded=1;dashed=1;fillColor=#FCE8EC;strokeColor=#A61E4D;fontColor=#A61E4D;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;opacity=80;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="800" height="290" as="geometry"/></mxCell><mxCell id="n_a" value="1. Recibir&#xa;Wazuh ≥10 (correo/tablero) ·&#xa;Kaspersky · NGFW · buzón phishing" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF8DB;strokeColor=#B8860B;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="n_b" value="2. Registrar&#xa;ticket GLPI con plantilla&#xa;“Alerta de seguridad”" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FB;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="n_c" value="3. Enriquecer&#xa;inventario GLPI · historial&#xa;Wazuh · reputación IP/URL/hash" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FB;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="n_d" value="4. Clasificar&#xa;falso positivo / benigno /&#xa;verdadero positivo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3EEFA;strokeColor=#6B46A8;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="n_fp" value="Falso positivo o benigno&#xa;cerrar con solución + proponer ajuste&#xa;de regla (ticket de Cambio)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F1F1;strokeColor=#777777;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="400" height="70" as="geometry"/></mxCell><mxCell id="n_sev" value="5. Asignar severidad&#xa;Crítica 15 min · Alta 30 min&#xa;Media 2 h · Baja 8 h" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDEBD3;strokeColor=#E8590C;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="940" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_pb" value="6. Ejecutar playbook&#xa;PB-01 … PB-09&#xa;(solo acciones permitidas al N1)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1F1F2E;strokeColor=#1F1F2E;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_dec" value="¿Requiere escalar?&#xa;compromiso confirmado, activo&#xa;crítico, Alta/Crítica, varios equipos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_cl" value="7a. Cerrar&#xa;solución documentada&#xa;en GLPI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_esc" value="7b. Escalar a N2&#xa;plantilla · grupo SOC N2 ·&#xa;llamada si Alta/Crítica" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_n2" value="N2 investiga y decide&#xa;contención mayor,&#xa;restauración, notificación" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_inc" value="Informe de incidente&#xa;(Anexo D) · aviso a gerencia;&#xa;Ley 1581 si hay datos personales" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDEBD3;strokeColor=#E8590C;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="n_lec" value="8. Aprender&#xa;lección aprendida · ajuste de reglas y&#xa;políticas · KPIs (MTTA, MTTR, FP)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="400" height="80" as="geometry"/></mxCell><mxCell id="n_p0" value="Cuarentena de archivo desde Kaspersky" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_p1" value="Aislar equipo (Alta/Crítica) y avisar a N2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_p2" value="Bloqueo temporal de IP/dominio en el NGFW" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="60" y="716" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_p3" value="Cierre de sesiones y cambio de clave (cuenta no privilegiada)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="60" y="764" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_p4" value="Pedir al usuario no tocar el equipo · desmontar unidad de red" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF6EC;strokeColor=#2F7D3A;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="60" y="812" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_q0" value="Borrar o alterar evidencias" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="880" y="620" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_q1" value="Apagar el NAS o el servidor · restaurar · reinstalar" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="880" y="668" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_q2" value="Eliminar o modificar cuentas privilegiadas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="880" y="716" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_q3" value="Cambiar políticas, exclusiones o reglas sin ticket" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="880" y="764" width="760" height="40" as="geometry"/></mxCell><mxCell id="n_q4" value="Forense, ingeniería inversa o acciones ofensivas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCE8EC;strokeColor=#A61E4D;strokeWidth=2;fontColor=#1F1F2E;" vertex="1" parent="1"><mxGeometry x="880" y="812" width="760" height="40" as="geometry"/></mxCell><